# API server (192.168.111.200) environment.
# Copy to .env.api and replace every "replace-with-..." value.
# Never commit .env.api.

APP_NAME=LBVD Dashboard
APP_VERSION=1.0.0
DEBUG=false

# Sessions. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32
SESSION_MAX_AGE_HOURS=8

# LAN deployment over plain HTTP keeps this false. Set true only when the web
# server terminates HTTPS (otherwise login cannot set the cookie).
COOKIE_HTTPS_ONLY=false

# Offline APK sync must use an authenticated session.
SYNC_REQUIRE_AUTH=true

# Survey drafts expire after one day in Redis.
SURVEY_DRAFT_TTL_SECONDS=86400
DB_RETRY_ATTEMPTS=3

# Database server on the LAN (use the same password as .env.db).
DB_HOST=192.168.111.100
DB_PORT=3306
DB_NAME=lbvd
DB_USER=lbvd
DB_PASSWORD=replace-with-the-same-password-as-.env.db

# Connection pool per uvicorn worker. 16 workers x (8 + 8) = 256 connections,
# comfortably below MariaDB max_connections=600.
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=8
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# 32 vCPU VM. Keep workers x (pool + overflow) below the DB limit.
WEB_CONCURRENCY=16
WEB_CONCURRENCY_LIMIT=1200
WEB_BACKLOG=2048
WEB_TIMEOUT_KEEP_ALIVE=30

# Trust X-Forwarded-* only from the web server.
FORWARDED_ALLOW_IPS=192.168.111.50

TZ=Asia/Yangon
