# Database server (192.168.111.100) environment.
# Copy to .env.db and replace every "replace-with-..." value.
# Never commit .env.db.

DB_NAME=lbvd
DB_USER=lbvd

# Generate with: openssl rand -hex 24
# URL-safe characters are not required because the app builds the connection
# from DB_HOST/DB_USER/DB_PASSWORD instead of a DATABASE_URL string.
DB_PASSWORD=replace-with-long-random-password
DB_ROOT_PASSWORD=replace-with-another-long-random-password

TZ=Asia/Yangon
