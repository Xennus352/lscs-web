# Copy to .env.prod and fill in real values. Never commit .env.prod.
# This file is read by: docker compose --env-file .env.prod -f docker-compose.prod.yml

# Domain name that already points at this VPS (Caddy issues the certificate).
DOMAIN=lbvd.example.com

# Redis is bundled in docker-compose.prod.yml. Uncomment only to use an
# external Redis instance instead.
# REDIS_URL=redis://redis:6379/0

# Database credentials. Use long random values.
# Keep DB_PASSWORD URL-safe (letters and digits only) because it is embedded
# in DATABASE_URL; otherwise URL-encode it.
DB_PASSWORD=replace-with-long-random-password
DB_ROOT_PASSWORD=replace-with-another-long-random-password

# Secrets: generate with `openssl rand -hex 32`.
SESSION_SECRET=replace-with-openssl-rand-hex-32

# Session lifetime in hours.
SESSION_MAX_AGE_HOURS=8

# Shown in the UI / API.
APP_VERSION=1.0.0
